{
  "name": "@workspace/mystatclips-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/create-entries.mjs && vite --host 0.0.0.0",
    "build": "node scripts/create-entries.mjs && vite build && vite build --ssr src/App.tsx --outDir .prerender && node scripts/prerender.mjs",
    "serve": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run build && node scripts/check-build.mjs"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "^0.5.21",
    "@replit/vite-plugin-dev-banner": "^0.1.1",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}